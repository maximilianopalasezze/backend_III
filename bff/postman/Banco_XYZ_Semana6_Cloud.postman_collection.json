          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con rol SERVICE',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "MS Movimientos - SERVICE = 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8092/api/movimientos/cuenta/106?limite=5",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8092",
              "path": [
                "api",
                "movimientos",
                "cuenta",
                "106"
              ],
              "query": [
                {
                  "key": "limite",
                  "value": "5"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",

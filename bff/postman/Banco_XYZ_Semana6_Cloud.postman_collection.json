{
  "info": {
    "name": "Banco XYZ - Semana 6 Spring Cloud",
    "description": "Config Server, Eureka, 3 microservicios, HTTP Basic con roles, BFF por HTTP/Service Discovery y Resilience4j.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Infraestructura",
      "item": [
        {
          "name": "Config Server - MS CUENTAS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8888/ms-cuentas/default",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8888",
              "path": [
                "ms-cuentas",
                "default"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Config Server responde 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eureka - Registro de servicios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8761/eureka/apps",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8761",
              "path": [
                "eureka",
                "apps"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Eureka responde',()=>pm.expect(pm.response.code).to.be.oneOf([200,204]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Seguridad HTTP Basic",
      "item": [
        {
          "name": "MS Cuentas - Sin credenciales = 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8091/api/cuentas/106",
              "protocol": "http",
              "host": [
                "localhost"

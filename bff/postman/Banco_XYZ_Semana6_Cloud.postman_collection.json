          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin autenticacion',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "MS Cuentas - VIEWER = 403",
          "request": {
            "method": "GET",
            "header": [],

    {
      "name": "06 - Tolerancia a fallos",
      "description": "Prueba manual: detén MS-MOVIMIENTOS y ejecuta nuevamente la consulta Web. El BFF debe seguir respondiendo 200 y movimientosRecientes debe quedar vacío por el fallback de Resilience4j.",
      "item": [
        {
          "name": "Web con MS-MOVIMIENTOS detenido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:8081/api/bff/web/cuentas/106",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "bff",
                "web",
                "cuentas",
                "106"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{webToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respuesta degradada controlada',()=>pm.response.to.have.status(200));",
                  "pm.test('Fallback deja movimientos vacios',()=>pm.expect(pm.response.json().movimientosRecientes).to.eql([]));"
                ]
              }
            }
          ]
        }
      ]
    }

                },
                {
                  "key": "password",
                  "value": "{{backendServicePassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 movimientos',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - BFF WEB",
      "item": [
        {
          "name": "Obtener token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://localhost:8081/api/auth/token",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"usuario\": \"web-demo\", \"password\": \"{{webPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token web 200',()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200) pm.environment.set('webToken',pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulta protegida",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://localhost:8081/api/bff/web/cuentas/106",
              "protocol": "https",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "bff",
                "web",
                "cuentas",
                "106"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{webToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('BFF responde 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },

                ]
              }
            }
          ]
        },
        {
          "name": "MS Cuentas - SERVICE = 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8091/api/cuentas/106",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8091",

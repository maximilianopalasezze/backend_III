              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{webUrl}}/api/auth/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"web-demo\",\n  \"password\": \"{{webPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"webToken\", pm.response.json().access_token); }",

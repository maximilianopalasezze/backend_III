# Copiar como .env.docker.local y reemplazar los valores.

MYSQL_ROOT_PASSWORD=CAMBIAR
DB_PASSWORD=CAMBIAR
BACKEND_BASIC_PASSWORD=CAMBIAR
BFF_TLS_PASSWORD=changeit

OAUTH_WEB_SECRET=CAMBIAR
OAUTH_MOVIL_SECRET=CAMBIAR
OAUTH_CAJERO_SECRET=CAMBIAR

# Asociación de cuentas de los clientes OAuth2 de demostración.
# Estas variables las define el servidor; no se aceptan desde la solicitud del token.
OAUTH_WEB_CUENTA_ID=102
OAUTH_MOVIL_CUENTA_ID=102
OAUTH_CAJERO_CUENTA_ID=102
OAUTH_WEB_CUENTAS=
OAUTH_MOVIL_CUENTAS=
OAUTH_CAJERO_CUENTAS=
